> EXPORT MOLCAS_MOLDEN=ON

> COPY $InpDir/$Project.xyz $WorkDir
> COPY $InpDir/$Project.key $WorkDir
> COPY $InpDir/melacu63.prm $WorkDir

&Gateway
 Tinker
 Group = NoSym
 Basis = 6-31G*

>   DoWhile

   &SEWARD
   &ESPF
    External = Tinker
    lamorok
   &SCF
    KSDFT=B3LYP 
    charge=1
  &ALASKA
  &SLAPAF
     cartesian
     rHidden = 4.0
> COPY $WorkDir/$Project.xyz $InpDir/$Project.Final.xyz
> EndDo
